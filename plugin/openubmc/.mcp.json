{
  "mcpServers": {
    "openubmc-target-runtime": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-I",
        "./scripts/pluginctl.py",
        "runtime"
      ],
      "cwd": "./",
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 900
    },
    "openubmc-kb": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "-I",
        "./scripts/pluginctl.py",
        "kb"
      ],
      "cwd": "./",
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 900
    }
  }
}
